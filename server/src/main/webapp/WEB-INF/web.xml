<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://jcp.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://jcp.org http://jcp.org/web-app_4_0.xsd"
         version="4.0">

    <display-name>Course Management System Server</display-name>

    <servlet>
        <servlet-name>EnrollmentServlet</servlet-name>
        <servlet-class>com.kursova.servlet.EnrollmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnrollmentServlet</servlet-name>
        <url-pattern>/api/enrollments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>com.kursova.servlet.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/api/students</url-pattern>
    </servlet-mapping>

</web-app>

